      "tile_size": {
        "name": "타일 크기"
      },
      "overlap": {
        "name": "공간 겹침"
      },
      "temporal_size": {
        "name": "시간 타일 크기"
      },
      "temporal_overlap": {
        "name": "시간 겹침"
      },
      "output_mode": {
        "name": "전송",
        "options": {
          "shared": "공유 폴더",
          "tensor": "직접 전송"
        },
        "tooltip": "두 방식 모두 텐서 반환 · 직접 전송 512 MiB 한도"
      },
      "request_id": {
        "name": "재시도 ID"
      },
      "fps": {
        "name": "프레임 속도"
      },
      "audio_vae_name": {
        "name": "오디오 VAE"
      },
      "crf": {
        "name": "영상 품질 · CRF"
      }
    },
    "description": "두 전송 방식 모두 이미지 출력 · 저장은 후속 노드",
