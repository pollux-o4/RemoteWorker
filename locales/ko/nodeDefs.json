        "options": {
          "release_after_result": "해제",
          "keep": "유지"
        }
      },
      "warmup": {
        "name": "수동 준비 신호",
        "tooltip": "동일한 서버·VAE·대상의 미리 준비 노드 출력 연결. 생략 가능"
      },
      "tiled": {
        "name": "타일 디코딩",
        "tooltip": "타일 크기는 고급 설정에서 조절. H3 영상 VAE는 자체 타일 처리 지원"
